# Copia este archivo como ".env" y ajusta los valores.
# En Railway, DATABASE_URL la agrega automáticamente el plugin de PostgreSQL.

# Clave secreta para firmar las sesiones (usa un texto largo y aleatorio en producción)
SECRET_KEY=cambia-esta-clave-super-secreta-larga-y-unica

# Base de datos:
#   - Local (SQLite):   sqlite:///./taller.db
#   - Railway (Postgres): la variable la define Railway automáticamente
DATABASE_URL=sqlite:///./taller.db

# Nombre del entorno: development | production
ENV=development

# Usuario administrador inicial (solo se usa la primera vez que se crea la base de datos)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
